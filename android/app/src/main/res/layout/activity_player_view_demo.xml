<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp">

        <EditText
            android:id="@+id/playerViewUrlInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="输入本地路径或 rtsp:// 地址"
            android:imeOptions="actionDone"
            android:inputType="textUri"
            android:maxLines="1"
            android:singleLine="true"
            android:text="rtsp://192.168.1.1:554/live" />

        <Button
            android:id="@+id/playerViewSetPathButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="设置" />

    </LinearLayout>

    <RadioGroup
        android:id="@+id/playerViewTransportGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/playerViewTransportTcpButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="RTSP TCP" />

        <RadioButton
            android:id="@+id/playerViewTransportUdpButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="RTSP UDP" />

    </RadioGroup>

    <RadioGroup
        android:id="@+id/playerViewScaleGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/playerViewScaleFitButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="fit" />

        <RadioButton
            android:id="@+id/playerViewScaleCropButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="crop" />

        <RadioButton
            android:id="@+id/playerViewScaleFillButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="fill" />

        <RadioButton
            android:id="@+id/playerViewScaleOriginalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="original" />

    </RadioGroup>

    <com.echplay.player.ECHPlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="160dp">

        <TextView
            android:id="@+id/playerViewLogText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="PlayerView Demo\n"
            android:textColor="#666666"
            android:textSize="14sp" />

    </ScrollView>

</LinearLayout>
